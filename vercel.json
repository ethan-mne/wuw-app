{
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "crons": [
    {
      "path": "/api/cron/draw-reminders",
      "schedule": "*/3 * * * *"
    }
  ],
  "functions": {
    "src/app/api/**": {
      "maxDuration": 60
    }
  }
}
