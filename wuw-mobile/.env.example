VITE_API_BASE_URL=http://localhost:3000

# OneSignal — same App ID as backend ONESIGNAL_APP_ID (required for push via OneSignal)
# VITE_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Demo login: sign in with email only (requires DEMO_AUTH_ENABLED=true on the API)
# VITE_DEMO_AUTH_ENABLED=true

# iOS APNs environment stored with the device token (sandbox = Xcode Debug, production = TestFlight/App Store).
# VITE_APNS_ENVIRONMENT=sandbox

# Optional: used in referral WhatsApp / share text (defaults to https://winuwatch.uk)
# VITE_SITE_URL=https://winuwatch.uk
