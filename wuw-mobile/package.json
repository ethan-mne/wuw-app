{
  "name": "wuw-mobile",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "capacitor:assets": "npx capacitor-assets generate --ios --android --iconBackgroundColor \"#114f33\" --iconBackgroundColorDark \"#114f33\" --splashBackgroundColor \"#1d1b1c\" --splashBackgroundColorDark \"#1d1b1c\"",
    "android:sync": "npm run build:prod && ONESIGNAL_DISABLE_LOCATION=true npx cap sync android && node scripts/patch-fcm-android.mjs",
    "android:sync:dev": "tsc -b && vite build --mode development && ONESIGNAL_DISABLE_LOCATION=true npx cap sync android && node scripts/patch-fcm-android.mjs",
    "android:open": "npx cap open android",
    "android:bundle": "node scripts/android-bundle.mjs",
    "android:release": "npm run android:sync && npm run android:bundle",
    "ios:sync": "npm run build:prod && ONESIGNAL_DISABLE_LOCATION=true npx cap sync ios && node scripts/normalize-ios-spm-paths.mjs",
    "ios:sync:dev": "tsc -b && vite build --mode development && ONESIGNAL_DISABLE_LOCATION=true npx cap sync ios && node scripts/normalize-ios-spm-paths.mjs",
    "postinstall": "node scripts/patch-fcm-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@onesignal/capacitor-plugin": "^1.1.0",
    "@wuw/mobile-ui": "workspace:*",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.8"
  }
}
