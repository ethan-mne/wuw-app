<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to GoogleService-Info.plist (same folder) after downloading from Firebase Console:
  Project winuwatch-bd56d → add iOS app com.winuwatch.wuwapp → Download GoogleService-Info.plist

  In Xcode: add the file to the App target (Copy Bundle Resources).
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>YOUR_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>651859942451</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.winuwatch.wuwapp</string>
	<key>PROJECT_ID</key>
	<string>winuwatch-bd56d</string>
	<key>STORAGE_BUCKET</key>
	<string>winuwatch-bd56d.appspot.com</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:651859942451:ios:YOUR_IOS_APP_ID</string>
</dict>
</plist>
